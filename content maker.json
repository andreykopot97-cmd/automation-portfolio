    {
      "parameters": {
        "jsCode": "const o = $json.output;\nconst bannedWords = ['гарантований', 'безкоштовно назавжди', 'найкращий у світі'];\n\nconst errors = [];\n\nif (!o.linkedin?.text || o.linkedin.text.length > 3000) errors.push('linkedin text invalid/too long');\nif (!o.instagram?.caption || o.instagram.caption.length > 2200) errors.push('instagram caption invalid/too long');\nif (!o.email?.subject || o.email.subject.length > 100) errors.push('email subject too long');\nif (!o.email?.body_html) errors.push('email body missing');\n\nconst allText = `${o.linkedin?.text ?? ''} ${o.instagram?.caption ?? ''} ${o.email?.body_html ?? ''}`.toLowerCase();\nbannedWords.forEach(word => {\n  if (allText.includes(word.toLowerCase())) errors.push(`banned word: ${word}`);\n});\n\nreturn [{\n  json: {\n    ...$json,\n    validation_passed: errors.length === 0,\n    validation_errors: errors\n  }\n}];"
      },
